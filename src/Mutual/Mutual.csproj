<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mutual.Core\Mutual.Core.csproj" />
    <ProjectReference Include="..\Mutual.Stream\Mutual.Stream.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>mutual.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Mutual</Product>
    <Description>consent-first screen sharing and co-op for two friends</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>