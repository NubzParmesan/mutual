<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mutual.Core\Mutual.Core.csproj" />
    <ProjectReference Include="..\Mutual.Stream\Mutual.Stream.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>mutual.ico</ApplicationIcon>
    <Version>1.3.3</Version>
    <!-- release shape: one self contained exe, set here so build and publish restore the same packages -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Product>Mutual</Product>
    <Description>consent-first screen sharing and co-op for two friends</Description>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>